---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" description="The page you requested does not exist.">
  <section class="max-w-2xl mx-auto px-4 py-24 text-center">
    <p class="font-display text-7xl">404</p>
    <h1 class="font-display text-3xl mt-4">That page is not here.</h1>
    <p class="text-ink/65 mt-2">Try treatments, membership, or booking a free consult instead.</p>
    <div class="mt-6 flex justify-center gap-3 flex-wrap">
      <a href="/" class="bg-forest text-ivory font-bold px-7 py-3 rounded-full">Home</a>
      <a href="/treatments" class="border border-forest/20 font-bold px-7 py-3 rounded-full">Treatments</a>
    </div>
  </section>
</BaseLayout>
