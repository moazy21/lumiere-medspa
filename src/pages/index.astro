---
import BaseLayout from '../layouts/BaseLayout.astro';
import TreatmentCard from '../components/TreatmentCard.astro';
import Icon from '../components/Icon.astro';
import { treatments, reviews, faqs, site } from '../data/site.ts';
---
<BaseLayout title="Skin care that starts with medicine" description="LUMIÈRE is a provider-led skin studio in Denver. Facials, peels, microneedling, wrinkle relaxers, fillers and laser with exact pricing before you book.">
  <!-- HERO -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pt-10 md:pt-14 pb-10 grid gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:gap-14 items-center">
    <div>
      <p class="text-[13px] font-bold text-ink/55">Provider-led studio in RiNo, Denver</p>
      <h1 class="font-display text-[42px] sm:text-6xl lg:text-[68px] leading-[1.02] mt-3 pb-2">Skin care that starts with medicine.</h1>
      <p class="mt-4 text-[17px] text-ink/70 leading-relaxed max-w-[44ch]">Exact pricing before you book, natural results after. Start with a free 15 minute consult.</p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href="/contact" class="btn-primary inline-flex items-center gap-2 bg-forest text-ivory font-bold px-7 py-3.5 rounded-full hover:bg-pine transition">Book consultation <Icon name="arrow" /></a>
        <a href="/treatments" class="btn-ghost inline-flex items-center px-7 py-3.5 rounded-full border border-forest/20 font-bold hover:bg-cream transition">View treatments</a>
      </div>
      <p class="mt-5 text-sm flex items-center gap-2"><span class="inline-flex gap-0.5 text-[#8A6D3F]" aria-hidden="true"><Icon name="star" /><Icon name="star" /><Icon name="star" /><Icon name="star" /><Icon name="star" /></span><strong>{site.rating}</strong><span class="text-ink/60">from {site.reviewCount} guests. Openings this week.</span></p>
    </div>
    <div class="relative">
      <div class="rounded-[22px] overflow-hidden shadow-soft aspect-[4/5] sm:aspect-[5/4] lg:aspect-[4/5] bg-cream">
        <img src="https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?w=1000&q=80&auto=format&fit=crop" alt="Guest receiving a facial in a private treatment room" width="1000" height="1200" fetchpriority="high" decoding="async" class="w-full h-full object-cover" />
      </div>
      <div class="absolute -bottom-5 left-4 sm:left-6 bg-white rounded-2xl border border-stonewarm px-5 py-4 flex items-center gap-4" style="box-shadow: 0 14px 34px -18px rgba(21,40,36,.3)">
        <p class="font-display text-[26px] leading-none font-semibold tabular-nums">12k+</p>
        <p class="text-xs text-ink/60 leading-snug">treatments performed<br />by licensed providers</p>
      </div>
    </div>
  </section>

  <!-- CREDIBILITY ROW -->
  <section class="border-y border-stonewarm bg-cream/50" aria-label="Why guests trust us">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-5 grid grid-cols-2 lg:grid-cols-4 gap-4 text-[14px] font-semibold">
      <span>Licensed medical providers</span>
      <span>Written quote before treatment</span>
      <span>Private rooms, hospital hygiene</span>
      <span>Two week follow-up included</span>
    </div>
  </section>

  <!-- TREATMENTS -->
  <section id="treatments" class="max-w-7xl mx-auto px-4 sm:px-6 py-14 md:py-20">
    <div class="max-w-[62ch]">
      <h2 class="reveal font-display text-3xl sm:text-[44px] sm:leading-[1.08]">Start with your concern. Leave with a written plan.</h2>
      <p class="reveal mt-3 text-ink/65" style="--d:80ms">Eight treatments, four categories. Filter, compare downtime and price, then confirm at a free consult.</p>
    </div>
    <div class="mt-6 flex flex-wrap gap-2" id="filters" role="group" aria-label="Filter treatments by category">
      {['All','Skin','Laser','Injectables','Body'].map((c,i) => (
        <button data-filter={c} aria-pressed={i===0 ? 'true' : 'false'} class={`filter-btn px-5 py-2.5 rounded-full text-sm font-bold border transition min-h-[44px] ${i===0 ? 'bg-forest text-ivory border-forest' : 'border-forest/20 hover:bg-cream'}`}>{c}</button>
      ))}
    </div>
    <div id="grid" class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {treatments.map((t,i) => <div class="reveal" style={`--d:${(i%4)*70}ms`} data-category={t.category}><TreatmentCard t={t} /></div>)}
    </div>
    <p class="mt-4 text-xs text-ink/50">Sample pricing shown for layout. Final quote is confirmed in person.</p>
  </section>

  <!-- STUDIO -->
  <section class="bg-forest text-ivory">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-14 md:py-20 grid gap-10 lg:grid-cols-[0.95fr_1.05fr] items-center">
      <div class="rounded-[22px] overflow-hidden aspect-[4/3] bg-pine">
        <img src="https://images.unsplash.com/photo-1560066984-138dadb4c035?w=1000&q=80&auto=format&fit=crop" alt="Quiet treatment room with linen and daylight" loading="lazy" decoding="async" width="1000" height="750" class="w-full h-full object-cover" />
      </div>
      <div class="reveal">
        <h2 class="font-display text-3xl sm:text-[44px] sm:leading-[1.08]">Quiet room, clear plan, no sales pressure.</h2>
        <div class="mt-8 border-t border-ivory/15">
          <div class="py-5 border-b border-ivory/15"><p class="font-bold">Provider-led, always</p><p class="text-sm text-ivory/70 mt-1">A licensed clinician performs or supervises every treatment.</p></div>
          <div class="py-5 border-b border-ivory/15"><p class="font-bold">Natural first</p><p class="text-sm text-ivory/70 mt-1">Doses are conservative. You look rested, not different.</p></div>
          <div class="py-5 border-b border-ivory/15"><p class="font-bold">Built for lunch breaks</p><p class="text-sm text-ivory/70 mt-1">Most visits run 30 to 60 minutes with little to no downtime.</p></div>
        </div>
        <a href="/about" class="mt-6 inline-flex items-center gap-2 bg-ivory text-forest font-bold px-6 py-3 rounded-full text-sm">Meet the studio <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- RESULTS -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-14 md:py-20">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div class="max-w-[58ch]">
        <h2 class="reveal font-display text-3xl sm:text-[44px]">Results with timelines, not miracles.</h2>
        <p class="reveal mt-2 text-ink/65 text-[15px]" style="--d:80ms">Sample photography for layout. Your consult sets an honest timeline for your skin.</p>
      </div>
      <a href="/results" class="text-sm font-bold underline underline-offset-4">See all results</a>
    </div>
    <div class="reveal mt-8 grid gap-5 lg:grid-cols-[1.1fr_0.9fr]">
      <div class="ba-slider bg-white border border-stonewarm rounded-[20px] overflow-hidden">
        <div class="relative aspect-[4/3] overflow-hidden select-none" data-ba>
          <img src="https://images.unsplash.com/photo-1512290923902-8a9f81dc236c?w=900&q=80&auto=format&fit=crop" alt="Skin after microneedling course" loading="lazy" decoding="async" class="absolute inset-0 w-full h-full object-cover" />
          <div class="absolute inset-y-0 left-0 overflow-hidden" style="width:50%" data-ba-top>
            <img src="https://images.unsplash.com/photo-1552693673-1bf958298935?w=900&q=80&auto=format&fit=crop" alt="Skin before microneedling course" loading="lazy" decoding="async" class="h-full object-cover max-w-none" style="width:100vw" data-ba-img />
          </div>
          <div class="absolute top-0 bottom-0 w-0.5 bg-white" style="left:50%; box-shadow: 0 0 12px rgba(0,0,0,.4)" data-ba-line></div>
          <span class="absolute top-3 left-3 bg-forest text-ivory text-xs font-bold px-3 py-1 rounded-full">Before</span>
          <span class="absolute top-3 right-3 bg-ivory text-forest text-xs font-bold px-3 py-1 rounded-full">After</span>
        </div>
        <div class="p-5 flex items-center gap-4">
          <input type="range" min="0" max="100" value="50" class="w-full min-h-[44px]" aria-label="Drag to compare before and after" data-ba-range />
          <p class="text-sm font-bold whitespace-nowrap">Microneedling, 3 sessions</p>
        </div>
      </div>
      <ul class="grid grid-cols-2 gap-5">
        {[['Lip filler','1 session','https://images.unsplash.com/photo-1616394584738-fc6e612e71b9?w=600&q=80&auto=format&fit=crop'],['Wrinkle relaxers','2 weeks','https://images.unsplash.com/photo-1629909613654-28e377c37b09?w=600&q=80&auto=format&fit=crop'],['IPL photofacial','1 session','https://images.unsplash.com/photo-1519415943484-9fa1873496d4?w=600&q=80&auto=format&fit=crop'],['Signature facial','4 weeks','https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?w=600&q=80&auto=format&fit=crop']].map(r => (
          <li class="bg-white border border-stonewarm rounded-[20px] overflow-hidden">
            <img src={r[2]} alt={r[0]} loading="lazy" decoding="async" width="600" height="600" class="aspect-square w-full object-cover" />
            <div class="p-4"><p class="font-bold text-sm">{r[0]}</p><p class="text-xs text-ink/60">{r[1]}</p></div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- PROOF NUMBERS -->
  <section class="bg-cream/60 border-y border-stonewarm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10 grid grid-cols-2 lg:grid-cols-4 gap-6">
      {[['12000','+','Treatments performed',0],['98','%','Guests who return',0],['4.9','','Average guest rating',1],['9','','Years in practice',0]].map(s => (
        <div><p class="font-display text-4xl md:text-[44px] font-semibold tabular-nums"><span data-count={s[0]} data-suffix={s[1]} data-decimals={s[3]}>0</span></p><p class="text-sm text-ink/60 mt-1">{s[2]}</p></div>
      ))}
    </div>
  </section>

  <!-- VISIT STEPS + MEMBERSHIP -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 py-14 md:py-20 grid gap-10 lg:grid-cols-2">
    <div class="reveal">
      <h2 class="font-display text-3xl sm:text-[38px]">First visit takes 15 minutes.</h2>
      <ol class="mt-6 border-t border-stonewarm">
        {[['1','Consult','Talk through skin, history and what you want. Free.'],['2','Plan','Leave with a written plan and exact price. No commitment.'],['3','Treat','Book when ready. Follow-up is included.']].map(s => (
          <li class="flex gap-5 py-5 border-b border-stonewarm"><span class="w-10 h-10 shrink-0 grid place-items-center rounded-full bg-forest text-ivory font-bold tabular-nums" aria-hidden="true">{s[0]}</span><div><p class="font-bold">{s[1]}</p><p class="text-sm text-ink/70">{s[2]}</p></div></li>
        ))}
      </ol>
    </div>
    <div class="reveal bg-forest text-ivory rounded-[22px] p-8 sm:p-10" style="--d:120ms">
      <h3 class="font-display text-3xl">Membership for regulars.</h3>
      <p class="mt-2 text-ivory/70 text-[15px]">One treatment a month, 10 percent off extras, priority booking. Cancel anytime.</p>
      <p class="mt-6 font-display text-5xl tabular-nums">$99<span class="text-lg font-sans">/mo</span></p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/membership" class="bg-ivory text-forest font-bold px-6 py-3 rounded-full text-sm">Compare plans</a>
        <a href="/contact" class="border border-ivory/30 px-6 py-3 rounded-full text-sm font-bold">Book a visit</a>
      </div>
    </div>
  </section>

  <!-- REVIEWS -->
  <section class="marquee overflow-hidden py-8 border-y border-stonewarm bg-white" aria-label="Guest reviews">
    <h2 class="text-center font-display text-2xl sm:text-[30px]">Guests on the mirror check</h2>
    <p class="text-center text-sm text-ink/55 mt-1 mb-6">Sample reviews for layout</p>
    <div class="flex overflow-hidden">
      <div class="marquee-track flex gap-4 pr-4 shrink-0">
        {[...reviews, ...reviews].map(r => (
          <figure class="w-[300px] shrink-0 bg-ivory border border-stonewarm rounded-2xl p-5">
            <div class="inline-flex gap-0.5 text-[#8A6D3F]" aria-label="5 out of 5 stars"><Icon name="star" /><Icon name="star" /><Icon name="star" /><Icon name="star" /><Icon name="star" /></div>
            <blockquote class="mt-2 text-sm leading-relaxed">&ldquo;{r.text}&rdquo;</blockquote>
            <figcaption class="mt-3 text-xs font-bold">{r.name} <span class="font-normal text-ink/55">· {r.treatment}</span></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="max-w-3xl mx-auto px-4 sm:px-6 py-14 md:py-20">
    <h2 class="reveal font-display text-3xl sm:text-[38px] text-center">Plain answers before you book</h2>
    <div class="mt-8 border-t border-stonewarm">
      {faqs.map(f => (
        <details class="group py-5 border-b border-stonewarm">
          <summary class="flex justify-between items-center gap-4 cursor-pointer font-bold list-none min-h-[44px]">{f.q}<span class="ml-4 w-8 h-8 shrink-0 grid place-items-center rounded-full border border-forest/20 group-open:rotate-45 transition text-xl leading-none" aria-hidden="true">+</span></summary>
          <p class="mt-2 text-[15px] text-ink/70 leading-relaxed pr-10">{f.a}</p>
        </details>
      ))}
    </div>
    <div class="mt-10 text-center bg-sage/45 rounded-[22px] p-8 sm:p-10">
      <h3 class="font-display text-2xl">Consultations are free.</h3>
      <p class="text-[15px] text-ink/65 mt-1">Fifteen minutes, exact pricing, no obligation.</p>
      <a href="/contact" class="mt-5 inline-block bg-forest text-ivory font-bold px-8 py-3.5 rounded-full">Book your consultation</a>
    </div>
  </section>

<script>
  const btns = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('#grid > div');
  btns.forEach(b => b.addEventListener('click', () => {
    btns.forEach(x => { x.className = 'filter-btn px-5 py-2.5 rounded-full text-sm font-bold border transition min-h-[44px] border-forest/20 hover:bg-cream'; x.setAttribute('aria-pressed','false'); });
    b.className = 'filter-btn px-5 py-2.5 rounded-full text-sm font-bold border transition min-h-[44px] bg-forest text-ivory border-forest';
    b.setAttribute('aria-pressed','true');
    const f = (b as HTMLElement).dataset.filter;
    cards.forEach(c => {
      const show = f === 'All' || (c as HTMLElement).dataset.category === f;
      (c as HTMLElement).style.display = show ? '' : 'none';
    });
  }));
  document.querySelectorAll('[data-ba]').forEach(wrap => {
    const range = wrap.parentElement?.querySelector('[data-ba-range]') as HTMLInputElement;
    const top = wrap.querySelector('[data-ba-top]') as HTMLElement;
    const line = wrap.querySelector('[data-ba-line]') as HTMLElement;
    const img = wrap.querySelector('[data-ba-img]') as HTMLElement;
    const update = () => {
      const v = parseInt(range.value);
      top.style.width = v + '%'; line.style.left = v + '%';
      img.style.width = (wrap as HTMLElement).offsetWidth + 'px';
    };
    range?.addEventListener('input', update);
    range?.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') requestAnimationFrame(update);
    });
    window.addEventListener('resize', update); update();
  });
</script>
</BaseLayout>
