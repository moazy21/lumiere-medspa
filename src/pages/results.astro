---
import BaseLayout from '../layouts/BaseLayout.astro';
const items = [
  ['Lip Filler','After 1 session','Subtle volume, natural shape.','https://images.unsplash.com/photo-1616394584738-fc6e612e71b9?w=700&q=80&auto=format&fit=crop'],
  ['Botox','After 2 weeks','Smoother forehead, still expressive.','https://images.unsplash.com/photo-1629909613654-28e377c37b09?w=700&q=80&auto=format&fit=crop'],
  ['Laser Resurfacing','After 3 sessions','Brighter, even skin tone.','https://images.unsplash.com/photo-1519415943484-9fa1873496d4?w=700&q=80&auto=format&fit=crop'],
  ['Medical Facial','After 4 weeks','Clearer, hydrated, radiant.','https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?w=700&q=80&auto=format&fit=crop'],
  ['Microneedling','After 3 sessions','Texture refined, scars softened.','https://images.unsplash.com/photo-1512290923902-8a9f81dc236c?w=700&q=80&auto=format&fit=crop'],
  ['IPL Photofacial','After 1 session','Sun spots visibly faded.','https://images.unsplash.com/photo-1552693673-1bf958298935?w=700&q=80&auto=format&fit=crop'],
];
---
<BaseLayout title="Results" description="Before and after gallery: filler, Botox, laser, facials with honest timelines.">
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pt-10 md:pt-16">
    <h1 class="font-display text-4xl sm:text-5xl lg:text-[58px] lg:leading-[1.05]">Results with honest timelines.</h1>
    <p class="mt-3 text-ink/70 max-w-[55ch] text-[15px]">Sample photography for layout. Replace with your own before and after images. Individual results vary.</p>
    <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {items.map(r => (
        <figure class="bg-white border border-stonewarm rounded-[20px] overflow-hidden">
          <img src={r[3]} alt={r[0]} loading="lazy" decoding="async" width="700" height="525" class="aspect-[4/3] w-full object-cover" />
          <figcaption class="p-5"><p class="font-display text-lg">{r[0]}</p><p class="text-sm text-ink/70">&ldquo;{r[2]}&rdquo;</p><p class="text-xs font-bold mt-2 text-ink/60">{r[1]}</p></figcaption>
        </figure>
      ))}
    </div>
    <div class="mt-10 bg-forest text-ivory rounded-[24px] p-8 text-center">
      <h2 class="font-display text-2xl sm:text-3xl">Want results like these?</h2>
      <a href="/contact" class="mt-4 inline-block bg-ivory text-forest font-semibold px-8 py-3 rounded-full text-sm">Book free consultation</a>
    </div>
  </section>
</BaseLayout>
