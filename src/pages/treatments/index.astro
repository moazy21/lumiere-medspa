---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TreatmentCard from '../../components/TreatmentCard.astro';
import { treatments } from '../../data/site.ts';
---
<BaseLayout title="Treatments" description="Facials, peels, microneedling, Botox, fillers, laser hair removal, IPL and massage with transparent pricing.">
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pt-10 md:pt-16">
    <h1 class="font-display text-4xl sm:text-5xl lg:text-[58px] lg:leading-[1.05] max-w-[18ch]">Start with your concern. Leave with a plan.</h1>
    <p class="mt-3 text-ink/70 max-w-[55ch]">Every plan starts with a free consultation. Sample from-pricing below, exact quote confirmed before anything begins.</p>
    <div class="mt-6 flex flex-wrap gap-2" id="filters" role="group" aria-label="Filter treatments by category">
      {['All','Skin','Laser','Injectables','Body'].map((c,i) => (
        <button data-filter={c} aria-pressed={i===0 ? 'true' : 'false'} class={`filter-btn px-5 py-2.5 rounded-full text-sm font-bold border transition min-h-[44px] ${i===0 ? 'bg-forest text-ivory border-forest' : 'border-forest/20'}`}>{c}</button>
      ))}
    </div>
    <div id="grid" class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 pb-4">
      {treatments.map(t => <div data-category={t.category}><TreatmentCard t={t} /></div>)}
    </div>
  </section>
<script>
  const btns = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('#grid > div');
  btns.forEach(b => b.addEventListener('click', () => {
    btns.forEach(x => { x.className = 'filter-btn px-5 py-2.5 rounded-full text-sm font-bold border transition min-h-[44px] border-forest/20'; x.setAttribute('aria-pressed','false'); });
    b.className = 'filter-btn px-5 py-2.5 rounded-full text-sm font-bold border transition min-h-[44px] bg-forest text-ivory border-forest';
    b.setAttribute('aria-pressed','true');
    const f = (b as HTMLElement).dataset.filter;
    cards.forEach(c => { (c as HTMLElement).style.display = (f === 'All' || (c as HTMLElement).dataset.category === f) ? '' : 'none'; });
  }));
</script>
</BaseLayout>
