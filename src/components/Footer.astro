---
import { navLinks, site } from '../data/site.ts';
import Icon from './Icon.astro';
---
<footer class="bg-forest text-ivory mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class="font-display text-[28px] tracking-[0.08em]">LUMIÈRE</p>
      <p class="mt-3 text-sm text-ivory/70 max-w-[32ch] leading-relaxed">Provider-led skin studio in RiNo. Exact pricing before you book, follow-up after.</p>
      <p class="mt-4 text-sm flex items-center gap-1.5"><span class="inline-flex text-champagne" aria-hidden="true"><Icon name="star" /><Icon name="star" /><Icon name="star" /><Icon name="star" /><Icon name="star" /></span><span class="sr-only">Rated</span> {site.rating} from {site.reviewCount} guests</p>
    </div>
    <nav aria-label="Footer">
      <p class="text-[12px] uppercase tracking-[0.16em] text-ivory/55 mb-4">Explore</p>
      <ul class="space-y-2.5 text-[15px]">
        {navLinks.map(l => <li><a class="hover:underline underline-offset-4" href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
    <div>
      <p class="text-[12px] uppercase tracking-[0.16em] text-ivory/55 mb-4">Visit</p>
      <p class="text-sm leading-relaxed">{site.address}</p>
      <ul class="mt-3 text-sm space-y-1.5 text-ivory/80">
        {site.hours.map(h => <li class="flex justify-between gap-4"><span>{h[0]}</span><span>{h[1]}</span></li>)}
      </ul>
    </div>
    <div>
      <p class="text-[12px] uppercase tracking-[0.16em] text-ivory/55 mb-4">Book</p>
      <a href={site.phoneHref} class="text-lg font-bold hover:underline underline-offset-4">{site.phone}</a>
      <div class="mt-4">
        <a href="/contact" class="inline-block bg-ivory text-forest font-bold px-6 py-3 rounded-full text-sm hover:bg-white transition">Book consultation</a>
      </div>
    </div>
  </div>
  <div class="border-t border-ivory/15">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-5 flex flex-col sm:flex-row gap-2 justify-between text-xs text-ivory/55">
      <span>© 2026 LUMIÈRE Med Spa. Demonstration site with sample photography and pricing.</span>
      <span><a href="/contact" class="underline underline-offset-2">Privacy</a> · <a href="/contact" class="underline underline-offset-2">Terms</a></span>
    </div>
  </div>
  <div class="h-16 md:hidden" aria-hidden="true"></div>
</footer>
